# 复制成 .env 后按需修改（docker compose 会自动读取）

# 模式：teach 教学（仿真车间 + 实验任务）/ prod 生产
WQ_MODE=teach
# 工厂所在时区（看板按它分日、分班）
WQ_TZ=America/New_York
# 仿真倍速：1 = 实时；20 = 1 分钟相当于 20 分钟
WQ_SIM_SPEED=20

# ERPNext（沿用你电脑上 virtual-factory 那套，端口 8090）
# 在 ERPNext 里：右上角头像 → 我的设置 → API 访问 → 生成密钥，把两段填在这里
WQ_ERPNEXT_API=http://host.docker.internal:8090
WQ_ERPNEXT_URL=http://localhost:8090
WQ_ERP_API_KEY=
WQ_ERP_API_SECRET=
WQ_ERP_ABBR=WQ

# AI 工厂助手（可选；不填就用规则回答，简报和提醒照常）
WQ_CLAUDE_KEY=
WQ_CLAUDE_MODEL=claude-sonnet-5
WQ_DEEPSEEK_KEY=
# 选哪家（第 30 轮 H-6）：auto 时看地区——国内（WQ_AI_REGION=cn）只用已备案的 DeepSeek，不调用 Claude；
# 其他地区 Claude 优先、出错换 DeepSeek。WQ_AI_REGION 不填时按 WQ_TZ 推断（中国时区算 cn）。
# 厂长或老师也可以调 /api/admin/ai 切换（存在库里，重启后照样生效）
WQ_AI_PROVIDER=auto
WQ_AI_REGION=

# 工厂清单（第 30 轮）：不填 = 演示工厂“问渠减速器厂”（教学页面、实验、情景都在）；
# 填一份清单（如 ../plants/example-sewing.yaml，容器里是 /app/plants/example-sewing.yaml）就按它建车间，教学页面不显示。
# 校验清单：在 factory 目录运行 python -m factory.plant check 清单.yaml
WQ_PLANT_FILE=

# 登录签名用的密钥，随便填一串字母数字
WQ_SECRET=change-me-please

# 本地版（第 30 轮 H-5，factory/local/start.sh 或 start.ps1 会自动填）：local = 学校机房的本地版
# 本地版里填名字登录的人只能选学生岗位；勾“我是老师”并输下面的老师密码，才能当厂长、用生产模式和教师控制台
WQ_EDITION=
WQ_TEACHER_PASSWORD=
