# 复制成 .env 后按需修改（docker compose 会自动读取）

# 模式：teach 教学（仿真车间 + 实验任务）/ prod 生产
WQ_MODE=teach
# 工厂所在时区（看板按它分日、分班）
WQ_TZ=America/New_York
# 仿真倍速：1 = 实时；20 = 1 分钟相当于 20 分钟
WQ_SIM_SPEED=20

# ERPNext（沿用你电脑上 virtual-factory 那套，端口 8090）
# 在 ERPNext 里：右上角头像 → 我的设置 → API 访问 → 生成密钥，把两段填在这里
WQ_ERPNEXT_API=http://host.docker.internal:8090
WQ_ERPNEXT_URL=http://localhost:8090
WQ_ERP_API_KEY=
WQ_ERP_API_SECRET=
WQ_ERP_ABBR=WQ

# AI 工厂助手（可选；不填就用规则回答，简报和提醒照常）
WQ_CLAUDE_KEY=
WQ_CLAUDE_MODEL=claude-sonnet-5
WQ_DEEPSEEK_KEY=

# 登录签名用的密钥，随便填一串字母数字
WQ_SECRET=change-me-please
