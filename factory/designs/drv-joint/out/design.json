 "sheets": [
  {
   "key": "power",
   "name": "48 V 输入与母线",
   "name_en": "48 V input and DC bus",
   "note": "48 V 从 J1 进；母线电容 C1 470 μF / 63 V（例题 3）；R1、R2、R3 分压给 MCU 测母线电压（48 V → 3.0 V）。示例设计，未经硬件验证。",
   "svg": "drv-joint-1 48 V 输入与母线.svg"
  },
  {
   "key": "aux",
   "name": "辅助电源 12 / 5 / 3.3 V",
   "name_en": "Auxiliary supplies",
   "note": "U1 LMR16006Y 把 48 V 降到 12 V（栅极驱动用），U2、U3 线性稳压出 5 V（编码器、CAN）和 3.3 V（MCU、采样放大）。L1 22 μH、反馈 147 k / 10 k 的算法见设计说明。",
   "svg": "drv-joint-2 辅助电源 12 _ 5 _ 3.3 V.svg"
  },
  {
   "key": "bridge",
   "name": "三相桥",
   "name_en": "Three-phase bridge",
   "note": "三个半桥，每相上下两个 MOSFET（示例选型 BSC040N08NS5，80 V）；C11–C13 每相就近吸收开关电流。",
   "svg": "drv-joint-3 三相桥.svg"
  },
  {
   "key": "gate",
   "name": "栅极驱动",
   "name_en": "Gate drivers",
   "note": "每相一片半桥驱动 IR2101S：上管靠自举（D、C 1 μF）供电；栅极电阻 10 Ω（例题 2）；死区由 MCU 定时器给。",
   "svg": "drv-joint-4 栅极驱动.svg"
  },
  {
   "key": "sense",
   "name": "相电流采样与电机输出",
   "name_en": "Phase current sensing",
   "note": "相线上串 2 mΩ 采样电阻（R21–R23），INA240A1 放大 20 倍：40 mV/A，零点 1.65 V，量程 ±41 A（例题 1）。J2 接电机三相。",
   "svg": "drv-joint-5 相电流采样与电机输出.svg"
  },
  {
   "key": "mcu",
   "name": "MCU 与烧录口",
   "name_en": "MCU and programming",
   "note": "STM32G431（示例选型）：TIM1 三相互补 PWM、ADC 采三相电流与母线电压、TIM3 编码器、SPI1 读 SSI、FDCAN1；8 MHz 晶振；TP1–TP5 是烧录口和电源测试点。",
   "svg": "drv-joint-6 MCU 与烧录口.svg"
  },
  {
   "key": "io",
   "name": "编码器接口与 CAN",
   "name_en": "Encoder and CAN",
   "note": "J3 增量编码器 A/B/Z 经 1 kΩ / 220 pF 滤波（例题 4）进 MCU；J4 输出端绝对值编码器 SSI（两片 RS-485 收发）；J5 CAN（MCP2562，120 Ω 终端）。",
   "svg": "drv-joint-7 编码器接口与 CAN.svg"
  }
 ],
