(rule "pins_R212_BOP_BRO_B"
  (condition "((A.NetName == 'BOP' && B.NetName == 'BRO_B') || (A.NetName == 'BRO_B' && B.NetName == 'BOP')) && A.intersectsCourtyard('R212') && B.intersectsCourtyard('R212')")
  (constraint clearance (min 1.75mm)))
