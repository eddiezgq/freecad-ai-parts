(version 1)
(rule "AC_L-AC_N"
  (condition "(A.NetClass == 'AC_L' && B.NetClass == 'AC_N') || (A.NetClass == 'AC_N' && B.NetClass == 'AC_L')")
  (constraint clearance (min 2.6mm)))
(rule "AC_L-HV"
