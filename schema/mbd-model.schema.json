{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/mbd-model.schema.json",
  "title": "多体动力学模型",
  "description": "多体动力学模块（ADR-0097）的一个模型：构件、运动副、驱动、力元、测量、分析。单位只用 mm、kg、kg·m²、s、°、N、N·m（字段名带单位后缀）。位置、方向都写装配好时（t = 0）在地面坐标系里的值；构件坐标系在 t = 0 时与地面坐标系同向、原点在质心。D1：刚体；固定、转动、移动、圆柱、球、万向副；运动副驱动；重力、恒定或函数的力与力矩、点对点弹簧阻尼；运动学、动力学、静平衡。后续各段扩充时另写 ADR 补充并单独改本文件。 D2（ADR-0097 补充三）：运动副摩擦、转动副间隙；衬套、梁、转动弹簧阻尼、测量量与样条；表达式里的 IMPACT、SPLINE。 D3（ADR-0097 补充五）：接触几何 geometries、接触对 contacts、齿轮啮合力元 gear_mesh。",
  "type": "object",
  "properties": {
    "format": {
      "const": "mbd-model/1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "gravity_mm_s2": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3,
      "description": "重力加速度向量（mm/s²），例如 [0, 0, -9810]；不写则没有重力"
    },
    "bodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "description": "构件（刚体）。地面不用写，id 固定为 ground",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string",
            "maxLength": 200
          },
          "mass_kg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cm_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "质心位置（地面坐标系，t = 0）"
          },
          "inertia_kg_m2": {
            "type": "object",
            "description": "对质心、沿地面坐标轴（t = 0）的惯性张量的分量：ixx、iyy、izz 是对角元；ixy、ixz、iyz 是张量的非对角元本身（= −∫xy dm 等）",
            "properties": {
              "ixx": {
                "type": "number"
              },
              "iyy": {
                "type": "number"
              },
              "izz": {
                "type": "number"
              },
              "ixy": {
                "type": "number"
              },
              "ixz": {
                "type": "number"
              },
              "iyz": {
                "type": "number"
              }
            },
            "required": [
              "ixx",
              "iyy",
              "izz"
            ],
            "additionalProperties": false
          },
          "v0_mm_s": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "质心初速度（可选；与运动副不相容的部分由程序按最小改动修正）"
          },
          "w0_deg_s": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "初角速度（地面坐标系，可选）"
          },
          "source": {
            "type": "string",
            "maxLength": 500,
            "description": "质量、惯量的出处（几何 + 材料算的写算法与材料 id）"
          }
        },
        "required": [
          "id",
          "mass_kg",
          "cm_mm",
          "inertia_kg_m2"
        ],
        "additionalProperties": false
      }
    },
    "joints": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "type": {
            "enum": [
              "fixed",
              "revolute",
              "translational",
              "cylindrical",
              "spherical",
              "universal"
            ]
          },
          "body_i": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
            "description": "构件 id；地面写 ground"
          },
          "body_j": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
            "description": "构件 id；地面写 ground"
          },
          "point_mm": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "运动副中心（地面坐标系，t = 0）"
          },
          "axis": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "转动 / 移动 / 圆柱副的轴；万向副不用"
          },
          "axis_i": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "万向副：在 body_i 上的十字轴方向"
          },
          "axis_j": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3,
            "description": "万向副：在 body_j 上的十字轴方向（与 axis_i 垂直）"
          },
          "initial_speed": {
            "type": "number",
            "description": "运动副初速度（可选）：转动副 °/s、移动副 mm/s；j 相对 i、沿 axis"
          },
          "friction": {
            "type": "object",
            "description": "运动副摩擦（D2）：只用于转动副、移动副。摩擦力 = μ(v)·(反力 + 预载)，μ 在静、动摩擦系数间按速度光滑过渡；转动副的摩擦力矩 = 摩擦力 × 销半径",
            "properties": {
              "mu_static": {
                "type": "number",
                "minimum": 0
              },
              "mu_dynamic": {
                "type": "number",
                "minimum": 0
              },
              "stiction_speed": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "静摩擦过渡速度：转动副 °/s、移动副 mm/s（相对速度小于它时 μ 从 0 升到 μs）"
              },
              "transition_speed": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "静→动摩擦过渡结束的速度（同上单位，要大于 stiction_speed）"
              },
              "pin_radius_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "转动副的销半径（摩擦力臂）"
              },
              "preload_n": {
                "type": "number",
                "minimum": 0,
                "description": "预载（与反力无关的正压力）"
              }
            },
            "required": [
              "mu_static",
              "mu_dynamic",
              "stiction_speed",
              "transition_speed"
            ],
            "additionalProperties": false
          },
          "clearance": {
            "type": "object",
            "description": "转动副间隙（D2）：销与孔之间留径向间隙，径向不再是理想约束，改成接触力：间隙用完以后 F = k·δ^e + 阻尼（压入深度在 0 到 depth 之间阻尼从 0 升到全值）；两轴仍平行、轴向不动",
            "properties": {
              "radial_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "径向间隙（孔半径 − 销半径）"
              },
              "stiffness_n_per_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "接触刚度 k（e = 1 时 N/mm；e ≠ 1 时 N/mm^e）"
              },
              "exponent": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "力指数 e（缺省 1；Hertz 线接触约 1，点接触 1.5）"
              },
              "damping_n_s_per_mm": {
                "type": "number",
                "minimum": 0
              },
              "penetration_mm": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "阻尼升到全值的压入深度（缺省 0.01 mm）"
              }
            },
            "required": [
              "radial_mm",
              "stiffness_n_per_mm"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "body_i",
          "body_j",
          "point_mm"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "revolute",
                    "translational",
                    "cylindrical"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "axis"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "universal"
                }
              }
            },
            "then": {
              "required": [
                "axis_i",
                "axis_j"
              ]
            }
          }
        ]
      }
    },
    "motions": {
      "type": "array",
      "maxItems": 200,
      "description": "运动副驱动：给定运动副的相对位移随时间的函数（j 相对 i）",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "joint": {
            "$ref": "#/$defs/id"
          },
          "dof": {
            "enum": [
              "rotation",
              "translation"
            ],
            "description": "转动副只能 rotation；移动副只能 translation；圆柱副两样都可"
          },
          "function": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "description": "位移随时间：rotation 是 °、translation 是 mm，t = 0 时的位置记为 0（相对装配位置）"
          },
          "speed": {
            "type": "number",
            "description": "匀速的简写：rotation 是 rpm、translation 是 mm/s（与 function 二选一）"
          }
        },
        "required": [
          "id",
          "joint",
          "dof"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "function"
            ]
          },
          {
            "required": [
              "speed"
            ]
          }
        ]
      }
    },
    "forces": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "force"
              },
              "body": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "point_mm": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "frame": {
                "enum": [
                  "ground",
                  "body"
                ],
                "description": "分量所在坐标系：ground 地面坐标系（缺省）；body 随构件转"
              },
              "fx_n": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "函数表达式。力元里还能用测量量的 id 当变量（单位见 measures）和 IMPACT、SPLINE"
                  }
                ]
              },
              "fy_n": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "函数表达式。力元里还能用测量量的 id 当变量（单位见 measures）和 IMPACT、SPLINE"
                  }
                ]
              },
              "fz_n": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "函数表达式。力元里还能用测量量的 id 当变量（单位见 measures）和 IMPACT、SPLINE"
                  }
                ]
              }
            },
            "required": [
              "id",
              "type",
              "body",
              "point_mm"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "torque"
              },
              "body": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "frame": {
                "enum": [
                  "ground",
                  "body"
                ]
              },
              "tx_n_m": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "函数表达式。力元里还能用测量量的 id 当变量（单位见 measures）和 IMPACT、SPLINE"
                  }
                ]
              },
              "ty_n_m": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "函数表达式。力元里还能用测量量的 id 当变量（单位见 measures）和 IMPACT、SPLINE"
                  }
                ]
              },
              "tz_n_m": {
                "oneOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000,
                    "description": "函数表达式。力元里还能用测量量的 id 当变量（单位见 measures）和 IMPACT、SPLINE"
                  }
                ]
              }
            },
            "required": [
              "id",
              "type",
              "body"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "spring_damper"
              },
              "body_i": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "point_i_mm": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "body_j": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "point_j_mm": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "stiffness_n_per_mm": {
                "type": "number",
                "minimum": 0
              },
              "damping_n_s_per_mm": {
                "type": "number",
                "minimum": 0
              },
              "free_length_mm": {
                "type": "number",
                "minimum": 0,
                "description": "自由长度；不写则取 t = 0 时两点距离"
              },
              "preload_n": {
                "type": "number",
                "description": "自由长度时的力（拉为正）"
              }
            },
            "required": [
              "id",
              "type",
              "body_i",
              "point_i_mm",
              "body_j",
              "point_j_mm",
              "stiffness_n_per_mm"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "转动弹簧阻尼（D2）：绕运动副轴（或给的轴）的扭簧、扭转阻尼，转角按 j 相对 i、绕 axis，−180°…180°",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "rotational_spring_damper"
              },
              "body_i": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "body_j": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "axis": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "stiffness_n_m_per_deg": {
                "type": "number",
                "minimum": 0
              },
              "damping_n_m_s_per_deg": {
                "type": "number",
                "minimum": 0
              },
              "free_angle_deg": {
                "type": "number"
              },
              "preload_n_m": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "type",
              "body_i",
              "body_j",
              "axis",
              "stiffness_n_m_per_deg"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "衬套（D2）：两构件在一点之间的线性六向弹簧阻尼，分量沿 body_i 在 t = 0 时的坐标轴（与地面同向）；转角按小转角（转动向量）",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "bushing"
              },
              "body_i": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "body_j": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "point_mm": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "stiffness_n_per_mm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "damping_n_s_per_mm": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rot_stiffness_n_m_per_deg": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "rot_damping_n_m_s_per_deg": {
                "type": "array",
                "items": {
                  "type": "number",
                  "minimum": 0
                },
                "minItems": 3,
                "maxItems": 3
              },
              "preload_n": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "preload_n_m": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "id",
              "type",
              "body_i",
              "body_j",
              "point_mm"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "description": "梁（D2）：两构件之间一根直梁（欧拉–伯努利，可选剪切变形），梁轴从 point_i 指向 point_j，截面主轴给 y_axis（与梁轴垂直）；线性小变形，力按 body_i 坐标系算",
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "const": "beam"
              },
              "body_i": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "point_i_mm": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "body_j": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_\\-]{0,63}$",
                "description": "构件 id；地面写 ground"
              },
              "point_j_mm": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "y_axis": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 3,
                "maxItems": 3
              },
              "youngs_modulus_mpa": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shear_modulus_mpa": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "area_mm2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "iyy_mm4": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "绕截面 y 轴的惯性矩"
              },
              "izz_mm4": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "绕截面 z 轴的惯性矩"
              },
              "ixx_mm4": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "扭转常数 J"
              },
              "shear_area_ratio_y": {
                "type": "number",
                "exclusiveMinimum": 0,
