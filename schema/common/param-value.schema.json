{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/common/param-value.schema.json",
  "title": "参数值",
  "description": "每个参数是一个对象而不是裸数字：数值三选一（单值 value、范围 min/max、公差 nominal + tol_upper/tol_lower），并记录工况、来源、获取方式、置信度和复核状态。单位由字段名后缀表达（见实施细则第四节），本对象不含单位字段。min ≤ max、tol_lower ≤ 0 ≤ tol_upper 等跨字段数值关系由代码校验。",
  "type": "object",
  "properties": {
    "value": {
      "description": "单值。数字、字符串（枚举）、布尔，或字符串/数字列表（如驱动器支持的协议列表）",
      "anyOf": [
        {"type": "number"},
        {"type": "string", "minLength": 1},
        {"type": "boolean"},
        {"type": "array", "minItems": 1, "items": {"type": ["string", "number"]}}
      ]
    },
    "min": {"type": "number", "description": "范围下限"},
    "max": {"type": "number", "description": "范围上限"},
    "nominal": {"type": "number", "description": "名义值"},
    "tol_upper": {"type": "number", "description": "上偏差（与名义值同单位，带符号）"},
    "tol_lower": {"type": "number", "description": "下偏差（与名义值同单位，带符号）"},
    "condition": {"type": "string", "minLength": 1, "description": "该值成立的工况，规格书有就必填；厂商叫法不同时注明原文名称"},
    "source": {"$ref": "#/$defs/source"},
    "method": {"enum": ["extracted", "manual", "computed", "standard"]},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reviewed": {"type": "boolean"}
  },
  "required": ["source", "method", "confidence", "reviewed"],
  "additionalProperties": false,
  "oneOf": [
    {
      "title": "单值",
      "required": ["value"],
      "not": {"anyOf": [{"required": ["min"]}, {"required": ["max"]}, {"required": ["nominal"]}]}
    },
    {
      "title": "范围",
      "anyOf": [{"required": ["min"]}, {"required": ["max"]}],
      "not": {"anyOf": [{"required": ["value"]}, {"required": ["nominal"]}]}
    },
    {
      "title": "公差",
      "required": ["nominal"],
      "not": {"anyOf": [{"required": ["value"]}, {"required": ["min"]}, {"required": ["max"]}]}
    }
  ],
  "dependentRequired": {
    "tol_upper": ["nominal"],
    "tol_lower": ["nominal"]
  },
  "if": {"properties": {"method": {"const": "computed"}}, "required": ["method"]},
  "then": {"properties": {"source": {"required": ["formula"]}}},
  "else": {"properties": {"source": {"required": ["doc"]}}},
  "$defs": {
    "source": {
      "type": "object",
      "description": "来源：doc 为 data/sources.yaml 中登记的来源文档 id；计算值写 formula",
      "properties": {
        "doc": {"type": "string", "pattern": "^src-[a-z0-9]+(-[a-z0-9]+)*$"},
        "page": {"type": "integer", "minimum": 1},
        "formula": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "number": {
      "description": "数值型参数：value 为数字，或用范围/公差表示",
      "$ref": "#",
      "properties": {"value": {"type": "number"}}
    },
    "integer": {
      "description": "整数型参数（如孔数、相数），只用单值表示",
      "$ref": "#",
      "required": ["value"],
      "properties": {"value": {"type": "integer"}}
    },
    "string": {
      "description": "字符串型参数（枚举、型号等），只用单值表示",
      "$ref": "#",
      "required": ["value"],
      "properties": {"value": {"type": "string", "minLength": 1}}
    },
    "boolean": {
      "description": "布尔型参数，只用单值表示",
      "$ref": "#",
      "required": ["value"],
      "properties": {"value": {"type": "boolean"}}
    },
    "string_or_list": {
      "description": "单个字符串，或字符串列表（如驱动器端支持的多个协议）",
      "$ref": "#",
      "required": ["value"],
      "properties": {
        "value": {
          "anyOf": [
            {"type": "string", "minLength": 1},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          ]
        }
      }
    },
    "number_pair": {
      "description": "两个数字组成的尺寸，如安装面外形 [宽, 高]",
      "$ref": "#",
      "required": ["value"],
      "properties": {"value": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}}}
    }
  }
}
