{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/cam-post.schema.json",
 "title": "问渠CAM 后处理配置（cam-post/1）",
 "description": "ADR-0109：一个数控系统（家族）的程序写法开关。刀路、安全底线（没仿真不出、回读一致才出、未经实机验证要写明）不在这里，改不了。",
 "type": "object",
 "properties": {
  "format": {
   "const": "cam-post/1"
  },
  "id": {
   "type": "string",
   "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
  },
  "name": {
   "type": "string",
   "minLength": 1
  },
  "family": {
   "enum": [
    "fanuc",
    "siemens",
    "gsk",
    "hnc",
    "heidenhain",
    "okuma",
    "fagor",
    "num"
   ],
   "description": "数控系统家族：决定基本语法（G 代码写法、注释符号、子程序、回读规则）；okuma、fagor 见 ADR-0124，num 见 ADR-0127"
  },
  "kinds": {
   "type": "array",
   "items": {
    "enum": [
     "lathe",
     "mill"
    ]
   },
   "minItems": 1,
   "uniqueItems": true
  },
  "source": {
   "type": "string",
   "minLength": 1,
   "description": "配置从哪里来：机床说明书哪一册哪一页、哪个厂的习惯、谁定的"
  },
  "verified": {
   "type": "object",
   "description": "实机验证记录（ADR-0106 Q5c）：没有这一项就是“未经实机验证”",
   "properties": {
    "date": {
     "type": "string",
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "machine": {
     "type": "string",
     "minLength": 1
    },
    "by": {
     "type": "string",
     "minLength": 1
    },
    "note": {
     "type": "string"
    }
   },
   "required": [
    "date",
    "machine",
    "by"
   ],
   "additionalProperties": false
  },
  "program": {
   "type": "object",
   "properties": {
    "number_digits": {
     "type": "integer",
     "minimum": 1,
     "maximum": 8
    },
    "percent": {
     "type": "boolean",
     "description": "程序前后写 %"
    },
    "end": {
     "enum": [
      "M30",
      "M02"
     ]
    }
   },
   "additionalProperties": false
  },
  "sequence": {
   "type": "object",
   "properties": {
    "enabled": {
     "type": "boolean"
    },
    "start": {
     "type": "integer",
     "minimum": 0
    },
    "step": {
     "type": "integer",
     "minimum": 1
    }
   },
   "additionalProperties": false
  },
  "decimals": {
   "type": "object",
   "properties": {
    "coord": {
     "type": "integer",
     "minimum": 0,
     "maximum": 5
    },
    "feed": {
     "type": "integer",
     "minimum": 0,
     "maximum": 4
    }
   },
   "additionalProperties": false
  },
  "comments": {
   "enum": [
    "ascii",
    "utf8",
    "none"
   ]
  },
  "tool_change": {
   "type": "object",
   "properties": {
    "before": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+-]*$"
     }
    },
    "after": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+-]*$"
     }
    },
    "optional_stop": {
     "type": "boolean",
     "description": "工序之间写 M01 选择停"
    }
   },
   "additionalProperties": false
  },
  "coolant": {
   "enum": [
    "flood",
    "mist",
    "through",
    "off"
   ]
  },
  "cycles": {
   "type": "object",
   "properties": {
    "drill": {
     "type": "boolean",
     "description": "铣：钻孔用固定循环（G81 / G83 或对应写法）；false 展开成直线段"
    },
    "turn": {
     "type": "boolean",
     "description": "车：粗精车、车螺纹用固定循环（G71 / G70 / G76）"
    }
   },
   "additionalProperties": false
  },
  "subprograms": {
   "type": "boolean",
   "description": "每道工序写成一个子程序，主程序按顺序调用"
  },
  "millturn": {
   "type": "object",
   "description": "车铣中心：开 / 关动力刀、切入 / 切出 C 轴的程序行（ADR-0110；按机床说明书填，不写则带铣削段的车铣程序不出）；程序行另可带圆括号、方括号和逗号，用来写西门子的 SETMS(2)、SPOS[2]=0（ADR-0111）",
   "properties": {
    "live_on": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$"
     },
     "description": "开动力刀（动力刀转速 S 由后处理写在这之后；或在行里写 {rpm}，例如哈斯 M133 P{rpm}，ADR-0124）"
    },
    "live_off": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     }
    },
    "c_on": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "切入 C 轴（主轴变 C 轴）"
    },
    "c_off": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     }
    },
    "b_tool_comp": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "B 轴车铣中心（ADR-0120）：铣刀装在 B 轴主轴上时，B 定位之后开“沿刀轴方向的刀长补偿”的程序行（各家写法不同，按机床说明书填）；不写则 B 轴机床上带铣削段的程序不出"
    }
   },
   "additionalProperties": false
  },
  "twin": {
   "type": "object",
   "description": "双主轴交接的程序行（ADR-0121；按机床说明书填，缺一项则双主轴程序不出）",
   "properties": {
    "sync_on": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "主副主轴同步转（副主轴接料前）"
    },
    "sync_off": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "停同步（切断、副主轴退回后）"
    },
    "sub_clamp": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "副主轴卡盘夹紧"
    },
    "sub_unclamp": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "副主轴卡盘松开（程序末卸件）"
    },
    "sub_select": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "切到副主轴编程（之后的转速、C 轴指副主轴）"
    },
    "main_select": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "切回主主轴"
    },
    "sub_offset": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
     },
     "description": "副主轴一侧的工件坐标（例如 G55）"
    }
   },
   "additionalProperties": false
  },
  "channels": {
   "type": "object",
   "description": "多通道等待指令（ADR-0123；按机床说明书填，不写则不出多通道程序）",
   "properties": {
    "wait": {
     "type": "string",
     "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*\\{n\\}[A-Z0-9 .=+\\-()\\[\\],]*$",
     "description": "等待指令模板，{n} 处填等待号，例如 M{n}、WAITM({n},1,2)"
    },
    "wait_first": {
     "type": "integer",
     "minimum": 0,
     "description": "等待号从几开始"
    },
    "heads": {
     "type": "array",
     "items": {
      "type": "array",
      "items": {
       "type": "string",
       "pattern": "^[A-Z0-9 .=+\\-()\\[\\],]*$"
      }
     },
     "description": "每个通道程序开头的行（按通道顺序）"
    }
   },
   "required": [
    "wait",
    "wait_first"
   ],
   "additionalProperties": false
  },
  "dialect": {
   "type": "object",
   "description": "同一家族里各家写法的差别（ADR-0124）：模板里 {n} 刀号、{nn} 两位刀号、{o} 刀补号、{oo} 两位刀补号、{s} 转速、{r} 半径、{d} 直径、{rpm} 动力刀转速；按厂商手册填，每项写出处（sources）",
   "properties": {
    "tool_call_lathe": {
     "type": "string",
     "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
     "description": "车床换刀，例如 FANUC T{nn}{oo}、大隈 T{nn}{oo}{oo}、发格 T{n} D{o}"
    },
    "tool_call_mill": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
      "description": ""
     },
     "minItems": 1,
     "description": "铣床换刀的程序行，例如 [\"T{n} M06\"]、[\"M06 T{n}\"]"
    },
    "spindle_limit": {
     "type": "string",
     "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
     "description": "恒线速时的主轴限速，例如 G50 S{s}、G92 S{s}"
    },
    "polar": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
      "description": ""
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "极坐标插补开、关，例如 [\"G12.1\", \"G13.1\"]、哈斯 [\"G112\", \"G113\"]"
    },
    "cylindrical": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
      "description": ""
     },
     "minItems": 2,
     "maxItems": 2,
     "description": "圆柱插补开（带 {r} 或 {d}）、关，例如 [\"G07.1 C{r}\", \"G07.1 C0\"]"
    },
    "turn_cycles": {
     "enum": [
      "two_block",
      "one_block",
      "none"
     ],
     "description": "车削复合循环 G71 / G76 的写法：FANUC 两段、单段（D 切深）、不用（出直线段）"
    },
    "head": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
      "description": ""
     },
     "description": "程序开头的行（{number} 程序号），代替家族缺省的程序号行"
    },
    "foot": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$",
      "description": ""
     },
     "description": "程序结尾的行，代替家族缺省的结尾"
    },
    "sources": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "properties": {
       "item": {
        "type": "string",
        "minLength": 1,
        "description": "哪一项（dialect 的键、或 millturn.live_on 等）"
       },
       "doc": {
        "type": "string",
        "minLength": 1,
        "description": "厂商正式文件：名称与文件号"
       },
       "version": {
        "type": "string",
        "minLength": 1
       },
       "section": {
        "type": "string",
        "minLength": 1,
        "description": "章节或页码"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "item",
       "doc",
       "version",
       "section"
      ],
      "additionalProperties": false
     }
    },
    "codes": {
     "type": "object",
     "description": "这家数控系统手册里列出的 G、M 代码（ADR-0125）：正式程序里出现不在表里的代码就不出；按手册的代码表原样填",
     "properties": {
      "g": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^\\d{1,3}(\\.\\d)?$"
       },
       "minItems": 1,
       "description": "G 代码号，例如 \"00\"、\"12.1\"、\"112\""
      },
      "m": {
       "type": "array",
       "items": {
        "type": "string",
        "pattern": "^\\d{1,3}$"
       },
       "minItems": 1,
       "description": "M 代码号，例如 \"03\"、\"133\""
      }
     },
     "required": [
      "g",
      "m"
     ],
     "additionalProperties": false
    },
    "rigid_tap": {
     "type": "array",
     "items": {
      "type": "string",
      "pattern": "^[A-Z0-9 .=+\\-()\\[\\],#]*(\\{[a-z]+\\}[A-Z0-9 .=+\\-()\\[\\],#]*)*$"
     },
     "description": "刚性攻丝 G84 前面的程序行（{s} 转速），FANUC 是 [\"M29 S{s}\"]；不要这一行的写 []（例如哈斯铣床 M29 是别的功能，ADR-0125）"
    }
   },
   "required": [
    "sources"
   ],
   "additionalProperties": false
  },
  "checks": {
   "type": "array",
   "description": "实机之前的核对记录（ADR-0106 E、ADR-0124）：L2 独立解释器、L3 厂商系统软件；L4 实机写在 verified",
   "items": {
    "type": "object",
    "properties": {
     "level": {
      "enum": [
       "L2",
       "L3"
      ]
     },
     "tool": {
      "type": "string",
      "minLength": 1,
      "description": "用什么核对：软件名与版本，例如 LinuxCNC 2.9.4 rs274、SinuTrain 4.95"
     },
     "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
     },
     "by": {
      "type": "string",
      "minLength": 1
     },
     "evidence": {
      "type": "string",
      "minLength": 1,
      "description": "证据：测试名或截屏、导出文件的仓库路径"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "level",
     "tool",
     "date",
     "by",
     "evidence"
    ],
    "additionalProperties": false
   }
  }
 },
 "required": [
  "format",
  "id",
  "name",
  "family",
  "kinds",
  "source"
 ],
 "additionalProperties": false
}
