{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/rules/feature-clamping-matrix.schema.json",
  "title": "轴孔形式与紧固方式兼容矩阵",
  "description": "C2 校验用：轴的 feature、孔的 feature 与孔的 clamping 三者组合的判定结果。覆盖全部 4×4×4 组合。",
  "type": "object",
  "properties": {
    "table": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "verified"
      ]
    },
    "verification": {
      "type": "string",
      "description": "核对说明：谁、对照什么、何时"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "standard",
              "secondary",
              "engineering_judgment"
            ]
          },
          "accessed": {
            "type": "string",
            "format": "date"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "kind"
        ],
        "additionalProperties": false
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "shaft_feature": {
            "enum": [
              "plain",
              "keyed",
              "d_cut",
              "spline"
            ]
          },
          "bore_feature": {
            "enum": [
              "plain",
              "keyed",
              "d_cut",
              "spline"
            ]
          },
          "clamping": {
            "enum": [
              "key",
              "clamp_ring",
              "set_screw",
              "press_fit"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "warn",
              "fail"
            ]
          },
          "reason": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "description": "是否已由人对照标准原文核对"
          }
        },
        "required": [
          "shaft_feature",
          "bore_feature",
          "clamping",
          "result",
          "verified"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "table",
    "version",
    "status",
    "verification",
    "sources",
    "entries"
  ],
  "additionalProperties": false
}
