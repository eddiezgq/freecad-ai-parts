{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/fea-study.schema.json",
  "title": "有限元算例",
  "description": "有限元模块（ADR-0093）的一个算例：几何、材料分配、支承与载荷、分析步、网格控制、可信度核查。单位只用 mm、N、MPa、N·m、kg/m³（字段名带单位后缀）。第一版（F1）只含已实现的内容：单个实体、固定与圆柱支承、面力、压力、扭矩、力矩，静力与模态；后续各段（F2–F5）扩充时另写 ADR 补充并单独改本文件。",
  "type": "object",
  "properties": {
    "format": {"const": "fea-study/1"},
    "name": {"type": "string", "minLength": 1, "maxLength": 200},
    "bodies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "description": "参与计算的实体。F1 只支持一个；多体与连接在 F3 扩充",
      "items": {
        "type": "object",
        "properties": {
          "id": {"$ref": "#/$defs/id"},
          "step_path": {"type": "string", "minLength": 1, "description": "STEP 文件路径（本机）"},
          "material": {"type": "string", "minLength": 1, "description": "材料库 id（analysis/common/materials.yaml）"}
        },
        "required": ["id", "step_path", "material"],
        "additionalProperties": false
      }
    },
    "supports": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/$defs/fixed"}, {"$ref": "#/$defs/cyl_support"}]}
    },
    "loads": {
      "type": "array",
      "items": {"oneOf": [{"$ref": "#/$defs/force"}, {"$ref": "#/$defs/pressure"}, {"$ref": "#/$defs/torque"},
                          {"$ref": "#/$defs/moment"}]}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"oneOf": [{"$ref": "#/$defs/static"}, {"$ref": "#/$defs/modal"}]}
    },
    "mesh": {
      "type": "object",
      "properties": {
        "size_mm": {"type": "number", "exclusiveMinimum": 0, "description": "单元尺寸；不写时取包围盒对角线 / 30"},
        "refine_faces": {"$ref": "#/$defs/face_list", "description": "另外加密的面（载荷面总是加密）"},
        "max_elements": {"type": "integer", "minimum": 1000}
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "description": "可信度核查（ADR-0093 决策 2）。反力平衡、网格质量总是做；收敛与奇异点要多算几遍，可关",
      "properties": {
        "convergence": {"type": "boolean", "default": true},
        "levels": {"type": "integer", "minimum": 3, "maximum": 4, "default": 3, "description": "网格层数（含原网格）"},
        "refine_ratio": {"type": "number", "minimum": 1.3, "maximum": 2.0, "default": 1.6, "description": "相邻两层单元尺寸之比"},
        "tolerance_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5, "default": 0.05,
                            "description": "最大应力的网格误差估计（GCI）上限"},
        "balance_tolerance_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.05, "default": 0.001}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "description": "算例由谁起草；AI 起草的必须人确认后才能计算（ADR-0093 决策 3）",
      "properties": {
        "drafted_by": {"enum": ["human", "ai"]},
        "confirmed_by_human": {"type": "boolean"},
        "note": {"type": "string"}
      },
      "required": ["drafted_by", "confirmed_by_human"],
      "additionalProperties": false
    },
    "time_limit_s": {"type": "number", "exclusiveMinimum": 0}
  },
  "required": ["format", "bodies", "supports", "steps"],
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,39}$"},
    "face_list": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "axis": {
      "type": "object",
      "properties": {"origin_mm": {"$ref": "#/$defs/vec3"}, "dir": {"$ref": "#/$defs/vec3"}},
      "required": ["origin_mm", "dir"],
      "additionalProperties": false
    },
    "where": {
      "description": "作用在哪个实体的哪些面（面编号同 analysis fea faces 的清单）",
      "type": "object",
      "properties": {"body": {"$ref": "#/$defs/id"}, "faces": {"$ref": "#/$defs/face_list"}},
      "required": ["body", "faces"]
    },
    "fixed": {
      "allOf": [{"$ref": "#/$defs/where"}],
      "properties": {"type": {"const": "fixed"}, "body": true, "faces": true},
      "required": ["type"],
      "unevaluatedProperties": false
    },
    "cyl_support": {
      "allOf": [{"$ref": "#/$defs/where"}],
      "properties": {
        "type": {"const": "cyl_support"}, "body": true, "faces": true,
        "axis": {"$ref": "#/$defs/axis"},
        "dofs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["radial", "tangential", "axial"]}},
        "band_mm": {"type": "number", "minimum": 0}
      },
      "required": ["type", "axis"],
      "unevaluatedProperties": false
    },
    "force": {
      "allOf": [{"$ref": "#/$defs/where"}],
      "properties": {"type": {"const": "force"}, "body": true, "faces": true, "vector_n": {"$ref": "#/$defs/vec3"}},
      "required": ["type", "vector_n"],
      "unevaluatedProperties": false
    },
    "pressure": {
      "allOf": [{"$ref": "#/$defs/where"}],
      "properties": {"type": {"const": "pressure"}, "body": true, "faces": true, "value_mpa": {"type": "number"}},
      "required": ["type", "value_mpa"],
      "unevaluatedProperties": false
    },
    "torque": {
      "allOf": [{"$ref": "#/$defs/where"}],
      "properties": {"type": {"const": "torque"}, "body": true, "faces": true, "value_nm": {"type": "number"},
                     "axis": {"$ref": "#/$defs/axis"}},
      "required": ["type", "value_nm", "axis"],
      "unevaluatedProperties": false
    },
    "moment": {
      "allOf": [{"$ref": "#/$defs/where"}],
      "properties": {"type": {"const": "moment"}, "body": true, "faces": true, "vector_nm": {"$ref": "#/$defs/vec3"}},
      "required": ["type", "vector_nm"],
      "unevaluatedProperties": false
    },
    "static": {
      "type": "object",
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "static"}},
      "required": ["id", "type"],
      "additionalProperties": false
    },
    "modal": {
      "type": "object",
      "properties": {"id": {"$ref": "#/$defs/id"}, "type": {"const": "modal"},
                     "n_modes": {"type": "integer", "minimum": 1, "maximum": 50, "default": 6}},
      "required": ["id", "type"],
      "additionalProperties": false
    }
  }
}
