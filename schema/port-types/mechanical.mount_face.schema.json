{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/port-types/mechanical.mount_face.schema.json",
  "title": "非圆形安装面（mechanical.mount_face）",
  "description": "驱动器底板、壳体安装面。孔为通孔时给 hole_diameter_mm，螺纹孔时给 thread，至少给一项。孔位在端口坐标系的安装面内（x 水平、y 垂直），以端口原点为中心（ADR-0031）：rect 为 pitch_x_mm × pitch_y_mm 矩形的角点，4 孔占四角、2 孔占一对对角；linear 为沿 y 的单列，相邻孔距 pitch_y_mm。",
  "x-connects-to": [
    "mechanical.mount_face"
  ],
  "allOf": [
    {
      "$ref": "../common/port-base.schema.json"
    },
    {
      "$ref": "../common/port-base.schema.json#/$defs/mechanical"
    }
  ],
  "properties": {
    "type": {
      "const": "mechanical.mount_face"
    },
    "spec": {
      "type": "object",
      "properties": {
        "pattern": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/string"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "rect",
                    "linear"
                  ]
                }
              }
            }
          ],
          "description": "孔位阵列形式：rect（矩形角点）或 linear（沿 y 单列）"
        },
        "pitch_x_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number",
          "description": "rect：矩形水平边长（孔中心距）；linear 不得填写"
        },
        "pitch_y_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number",
          "description": "rect：矩形垂直边长；linear：相邻孔中心距"
        },
        "hole_count": {
          "$ref": "../common/param-value.schema.json#/$defs/integer"
        },
        "hole_diameter_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number"
        },
        "thread": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/string"
            },
            {
              "properties": {
                "value": {
                  "pattern": "^M[0-9]+(\\.[0-9]+)?(x[0-9]+(\\.[0-9]+)?)?$"
                }
              }
            }
          ]
        },
        "face_size_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number_pair",
          "description": "安装面外形 [宽, 高]"
        },
        "din_rail": {
          "$ref": "../common/param-value.schema.json#/$defs/boolean",
          "description": "是否支持导轨安装"
        }
      },
      "required": [
        "pattern",
        "pitch_y_mm",
        "hole_count"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "hole_diameter_mm"
          ]
        },
        {
          "required": [
            "thread"
          ]
        }
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "pattern": {
                "properties": {
                  "value": {
                    "const": "rect"
                  }
                }
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "required": [
              "pitch_x_mm"
            ],
            "properties": {
              "hole_count": {
                "properties": {
                  "value": {
                    "enum": [
                      2,
                      4
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "pattern": {
                "properties": {
                  "value": {
                    "const": "linear"
                  }
                }
              }
            },
            "required": [
              "pattern"
            ]
          },
          "then": {
            "not": {
              "required": [
                "pitch_x_mm"
              ]
            },
            "properties": {
              "hole_count": {
                "properties": {
                  "value": {
                    "minimum": 2
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
