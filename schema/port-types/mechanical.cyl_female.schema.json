{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/port-types/mechanical.cyl_female.schema.json",
  "title": "孔 / 内圆柱配合面（mechanical.cyl_female）",
  "description": "减速器输入孔、轴承内圈、轴承座孔等内圆柱配合面。 公差体系由 fit_system 指定，缺省为 ISO 286（ADR-0013）。",
  "x-connects-to": [
    "mechanical.cyl_male"
  ],
  "allOf": [
    {
      "$ref": "../common/port-base.schema.json"
    },
    {
      "$ref": "../common/port-base.schema.json#/$defs/mechanical"
    }
  ],
  "properties": {
    "type": {
      "const": "mechanical.cyl_female"
    },
    "spec": {
      "type": "object",
      "properties": {
        "diameter_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number",
          "description": "名义直径"
        },
        "fit_system": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/string"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "iso286",
                    "bearing"
                  ]
                }
              }
            }
          ],
          "description": "公差体系：iso286（缺省）或 bearing（滚动轴承内外圈，ISO 492 精度等级）"
        },
        "fit": {
          "$ref": "../common/param-value.schema.json#/$defs/string",
          "description": "iso286 时为孔公差带（大写，如 H7、JS7）；bearing 时为轴承精度等级 P0、P6、P5、P4、P2（对应 ISO 492 的 Normal、6、5、4、2 级）"
        },
        "feature": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/string"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "plain",
                    "keyed",
                    "d_cut",
                    "spline"
                  ]
                }
              }
            }
          ],
          "description": "孔的形式"
        },
        "clamping": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/string"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "key",
                    "clamp_ring",
                    "set_screw",
                    "press_fit"
                  ]
                }
              }
            }
          ],
          "description": "紧固方式；轴承内圈（fit_system 为 bearing）由装配设计决定，可不填（ADR-0024），其余必填"
        },
        "depth_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number"
        },
        "key_width_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number"
        },
        "accepted_diameter_range_mm": {
          "$ref": "../common/param-value.schema.json#/$defs/number",
          "description": "可换轴套时可接受的轴径范围，用 min/max 表示"
        }
      },
      "required": [
        "diameter_mm",
        "fit",
        "feature"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "fit_system": {
                "properties": {
                  "value": {
                    "const": "bearing"
                  }
                }
              }
            },
            "required": [
              "fit_system"
            ]
          },
          "then": {
            "properties": {
              "fit": {
                "properties": {
                  "value": {
                    "pattern": "^P(0|6|5|4|2)$"
                  }
                }
              }
            }
          },
          "else": {
            "properties": {
              "fit": {
                "properties": {
                  "value": {
                    "pattern": "^(JS|[A-Z])[0-9]{1,2}$"
                  }
                }
              }
            },
            "required": [
              "clamping"
            ]
          }
        }
      ]
    }
  }
}
