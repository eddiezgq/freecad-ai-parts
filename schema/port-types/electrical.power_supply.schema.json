{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/port-types/electrical.power_supply.schema.json",
  "title": "供电（electrical.power_supply）",
  "description": "电网、直流母线到驱动器的供电。电压通常用 min/max 范围表示。",
  "x-connects-to": [
    "electrical.power_supply"
  ],
  "allOf": [
    {
      "$ref": "../common/port-base.schema.json"
    },
    {
      "$ref": "../common/port-base.schema.json#/$defs/non_mechanical"
    }
  ],
  "properties": {
    "type": {
      "const": "electrical.power_supply"
    },
    "spec": {
      "type": "object",
      "properties": {
        "current_type": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/string"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    "ac",
                    "dc"
                  ]
                }
              }
            }
          ]
        },
        "voltage_v": {
          "$ref": "../common/param-value.schema.json#/$defs/number"
        },
        "phases": {
          "allOf": [
            {
              "$ref": "../common/param-value.schema.json#/$defs/integer"
            },
            {
              "properties": {
                "value": {
                  "enum": [
                    0,
                    1,
                    3
                  ]
                }
              }
            }
          ],
          "description": "交流 1 或 3 相，直流填 0"
        },
        "rated_current_a": {
          "$ref": "../common/param-value.schema.json#/$defs/number"
        },
        "frequency_hz": {
          "$ref": "../common/param-value.schema.json#/$defs/number"
        },
        "connector": {
          "$ref": "../common/param-value.schema.json#/$defs/string"
        }
      },
      "required": [
        "current_type",
        "voltage_v",
        "phases"
      ],
      "additionalProperties": false
    }
  }
}
