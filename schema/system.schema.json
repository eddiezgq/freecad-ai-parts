{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/system.schema.json",
  "title": "系统",
  "description": "一个设计方案：需求、组件实例及端口之间的连接。同一组件可出现多次（如两个轴承），因此用实例名区分。实例名唯一、连接引用的实例与端口存在、同一端口不重复连接等关系由代码校验。",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"},
    "requirement": {"$ref": "requirement.schema.json"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "instance": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "实例名，系统内唯一，如 motor、reducer、bearing_2"},
          "component": {"type": "string", "description": "组件 id，须为合法组件 id 格式", "pattern": "^(test\\.)?(servo_motor|reducer|drive|bearing|adapter|fastener)\\.[a-z0-9]+(-[a-z0-9]+)*\\.[a-z0-9]+([.-][a-z0-9]+)*$"}
        },
        "required": ["instance", "component"],
        "additionalProperties": false
      }
    },
    "connections": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "两个端口之间的连接，写作 <实例名>.<端口 id>；方向是否正确由 C1 判定，不由书写顺序决定",
        "properties": {
          "a": {"$ref": "#/$defs/port_ref"},
          "b": {"$ref": "#/$defs/port_ref"},
          "note": {"type": "string"}
        },
        "required": ["a", "b"],
        "additionalProperties": false
      }
    },
    "layout": {"$ref": "#/$defs/layout"},
    "note": {"type": "string"}
  },
  "required": ["id", "requirement", "components", "connections"],
  "additionalProperties": false,
  "$defs": {
    "port_ref": {"type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"},
    "layout": {
      "type": "object",
      "description": "布局结果（ADR-0034）：各实例在世界坐标中的位姿，长度单位 mm。由 FreeCAD 布局工具生成；给出时 C11 按它计算包络长度。位姿中的实例须在 components 中列出，未给位姿的实例视为未布局，由代码校验。",
      "properties": {
        "poses": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {"$ref": "#/$defs/pose"}
        },
        "note": {"type": "string"}
      },
      "required": ["poses"],
      "additionalProperties": false
    },
    "pose": {
      "type": "object",
      "description": "实例坐标系（组件包络坐标系）到世界坐标的刚体变换：先绕 rotation.axis 转 rotation.angle_deg 度，再平移 position_mm。旋转轴须为非零向量，由代码校验。",
      "properties": {
        "position_mm": {"$ref": "#/$defs/vec3"},
        "rotation": {
          "type": "object",
          "properties": {"axis": {"$ref": "#/$defs/vec3"}, "angle_deg": {"type": "number"}},
          "required": ["axis", "angle_deg"],
          "additionalProperties": false
        }
      },
      "required": ["position_mm", "rotation"],
      "additionalProperties": false
    },
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}}
  }
}
