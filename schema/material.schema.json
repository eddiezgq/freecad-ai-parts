{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddiezgq/freecad-ai-parts/schema/material.schema.json",
  "title": "材料",
  "description": "分析模块用的材料性能（ADR-0056）。标准单位：应力 MPa（N/mm²）、密度 kg/m³、导热 W/(m·K)、比热 J/(kg·K)、线膨胀 1/K。每条注明出处；没有出处的性能不写（模块报缺数据），不估。",
  "type": "object",
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*$"},
    "name": {"type": "string", "minLength": 1},
    "elastic_modulus_mpa": {"type": "number", "exclusiveMinimum": 0},
    "poisson_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5},
    "density_kg_m3": {"type": "number", "exclusiveMinimum": 0},
    "yield_strength_mpa": {"type": "number", "exclusiveMinimum": 0},
    "ultimate_strength_mpa": {"type": "number", "exclusiveMinimum": 0},
    "brittle": {"type": "boolean", "description": "脆性材料没有屈服，安全系数按抗拉强度"},
    "fatigue_limit_bending_mpa": {"type": "number", "exclusiveMinimum": 0, "description": "对称循环弯曲疲劳极限 σ₋₁（光滑试样）"},
    "fatigue_limit_torsion_mpa": {"type": "number", "exclusiveMinimum": 0, "description": "对称循环扭转疲劳极限 τ₋₁"},
    "sn_knee_cycles": {"type": "number", "exclusiveMinimum": 0, "description": "疲劳极限对应的循环次数 N_D"},
    "sn_exponent": {"type": "number", "exclusiveMinimum": 0, "description": "S-N 曲线斜率 k（Basquin：σᵏ·N = 常数）"},
    "thermal_conductivity_w_per_m_k": {"type": "number", "exclusiveMinimum": 0},
    "specific_heat_j_per_kg_k": {"type": "number", "exclusiveMinimum": 0},
    "thermal_expansion_per_k": {"type": "number", "exclusiveMinimum": 0},
    "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "note": {"type": "string"}
  },
  "required": ["id", "name", "sources"],
  "additionalProperties": false,
  "dependentRequired": {
    "sn_exponent": ["sn_knee_cycles", "fatigue_limit_bending_mpa"]
  }
}
